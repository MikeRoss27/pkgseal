{
  "identifier": "default",
  "description": "Default capability with core permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "window-state:default",
    "store:default",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "os:default",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPCONFIG/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": ["$APPCONFIG/**", "$APPDATA/**", "$APPCACHE/**"]
    }
  ]
}